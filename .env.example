# Copy this file to .env and fill in real values.

# --- Database (PostgreSQL, e.g. Neon) ---
# Your Neon connection string. Used locally and on the live site.
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# --- Image storage ---
# Added automatically by Vercel when you create a Vercel Blob store.
# Leave blank locally to save uploads to public/uploads instead.
BLOB_READ_WRITE_TOKEN=""

# --- Admin panel ---
# Password for signing in at /admin. Change this before putting the site online.
ADMIN_PASSWORD="admin"

# --- Customer accounts ---
# Secret used to sign customer login sessions. Use a long random string in
# production (e.g. run: openssl rand -hex 32).
AUTH_SECRET="dev-auth-secret-change-me"

# --- Stripe (checkout) ---
# Get these from https://dashboard.stripe.com/apikeys (use test keys while developing).
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Base URL the app runs on (used for Stripe success/cancel redirects).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Email (order confirmations + delivery/review emails) ---
# Free key from https://resend.com. Without it, emails are logged to the
# server console instead of being sent (the app still works).
RESEND_API_KEY=""
# The "from" address. Use onboarding@resend.dev for testing, or your own
# verified domain in production.
EMAIL_FROM="Nuvo <onboarding@resend.dev>"

# --- AI layer (used from Phase 3 onward) ---
# Anthropic API key for AI listing/pricing/support features.
ANTHROPIC_API_KEY="sk-ant-..."
