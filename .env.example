# Copy this file to .env and fill in real values.

# --- Database ---
# SQLite file-based database (zero setup). Created when you run `npm run db:push`.
DATABASE_URL="file:./dev.db"

# --- Admin panel ---
# Password for signing in at /admin. Change this before putting the site online.
ADMIN_PASSWORD="admin"

# --- Stripe (checkout) ---
# Get these from https://dashboard.stripe.com/apikeys (use test keys while developing).
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Base URL the app runs on (used for Stripe success/cancel redirects).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- AI layer (used from Phase 3 onward) ---
# Anthropic API key for AI listing/pricing/support features.
ANTHROPIC_API_KEY="sk-ant-..."
