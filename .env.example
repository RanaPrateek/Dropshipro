# Copy this file to .env and fill in real values.

# --- Database (used from Phase 2 onward) ---
# PostgreSQL connection string for Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/dropshipro?schema=public"

# --- Stripe (checkout) ---
# Get these from https://dashboard.stripe.com/apikeys (use test keys while developing).
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Base URL the app runs on (used for Stripe success/cancel redirects).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- AI layer (used from Phase 3 onward) ---
# Anthropic API key for AI listing/pricing/support features.
ANTHROPIC_API_KEY="sk-ant-..."
