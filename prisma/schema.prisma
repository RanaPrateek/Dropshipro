// Prisma schema for Dropshipro.
//
// Uses SQLite so the store runs on your machine with zero database setup —
// data is saved to a local file (prisma/dev.db). When we put the site online
// later, we switch the provider to PostgreSQL (the roadmap's production choice).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id           String      @id @default(cuid())
  slug         String      @unique
  title        String
  // Markdown: supports bold (**text**) and bullet lists (- item).
  description  String
  // Price stored in minor units (cents) to avoid floating-point issues.
  priceCents   Int
  // Original ("compare at") price in cents. When set and higher than
  // priceCents, the product shows as on sale / a deal.
  compareAtCents Int?
  currency     String      @default("usd")
  // One of: Women, Men, Electronics
  category     String
  // Primary thumbnail (= first gallery image). Kept for card/list views.
  image        String?
  // JSON array of image paths for the gallery, e.g. ["/uploads/a.jpg", ...].
  images       String      @default("[]")
  // JSON array of color names, e.g. ["Black","White","Navy"].
  colors       String      @default("[]")
  // JSON object mapping a color name to one of the gallery images,
  // e.g. {"Black":"/uploads/a.jpg","White":"/uploads/b.jpg"}.
  colorImages  String      @default("{}")
  // JSON array of size labels, e.g. ["S","M","L","XL"].
  sizes        String      @default("[]")
  // Inventory count. Null = not tracked (no stock badge shown).
  stock        Int?
  // When a deal's 24h countdown ends. Null = not on a timed deal.
  dealExpiresAt DateTime?
  // Social proof (admin-entered; 0 = hidden).
  ratingAvg    Float?
  reviewsCount Int         @default(0)
  soldCount    Int         @default(0)
  // Estimated shipping window in days.
  shipDaysMin  Int         @default(7)
  shipDaysMax  Int         @default(14)
  active       Boolean     @default(true)
  // Supplier fields (used for fulfillment later).
  supplierUrl  String?
  supplierCost Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  orderItems   OrderItem[]
}

model Customer {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  orders    Order[]
  createdAt DateTime @default(now())
}

model Order {
  id              String      @id @default(cuid())
  customer        Customer?   @relation(fields: [customerId], references: [id])
  customerId      String?
  email           String
  // One of: PENDING, PAID, ORDERED_WITH_SUPPLIER, SHIPPED, DELIVERED, CANCELLED, REFUNDED
  status          String      @default("PENDING")
  totalCents      Int
  currency        String      @default("usd")
  stripeSessionId String?     @unique
  shippingName    String?
  shippingLine1   String?
  shippingLine2   String?
  shippingCity    String?
  shippingState   String?
  shippingZip     String?
  shippingCountry String?
  supplierOrderId String?
  trackingNumber  String?
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id         String  @id @default(cuid())
  order      Order   @relation(fields: [orderId], references: [id])
  orderId    String
  product    Product @relation(fields: [productId], references: [id])
  productId  String
  quantity   Int
  priceCents Int
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  // One of: ADMIN, STAFF
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
}
