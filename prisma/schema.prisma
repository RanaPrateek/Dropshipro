// Prisma schema for Dropshipro.
//
// Uses PostgreSQL (hosted on Neon) so the same database works locally and on
// the live site. Set DATABASE_URL to your Neon connection string.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           String      @id @default(cuid())
  slug         String      @unique
  title        String
  // Markdown: supports bold (**text**) and bullet lists (- item).
  description  String
  // Price stored in minor units (cents) to avoid floating-point issues.
  priceCents   Int
  // Original ("compare at") price in cents. When set and higher than
  // priceCents, the product shows as on sale / a deal.
  compareAtCents Int?
  currency     String      @default("usd")
  // One of: Women, Men, Electronics
  category     String
  // Primary thumbnail (= first gallery image). Kept for card/list views.
  image        String?
  // JSON array of image paths for the gallery, e.g. ["/uploads/a.jpg", ...].
  images       String      @default("[]")
  // JSON array of color names, e.g. ["Black","White","Navy"].
  colors       String      @default("[]")
  // JSON object mapping a color name to one of the gallery images,
  // e.g. {"Black":"/uploads/a.jpg","White":"/uploads/b.jpg"}.
  colorImages  String      @default("{}")
  // JSON array of size labels, e.g. ["S","M","L","XL"].
  sizes        String      @default("[]")
  // Inventory count. Null = not tracked (no stock badge shown).
  stock        Int?
  // When a deal's 24h countdown ends. Null = not on a timed deal.
  dealExpiresAt DateTime?
  // Social proof (admin-entered; 0 = hidden).
  ratingAvg    Float?
  reviewsCount Int         @default(0)
  soldCount    Int         @default(0)
  // Estimated shipping window in days.
  shipDaysMin  Int         @default(7)
  shipDaysMax  Int         @default(14)
  active       Boolean     @default(true)
  // Supplier fields (used for fulfillment later).
  supplierUrl  String?
  supplierCost Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  orderItems   OrderItem[]
  reviews      Review[]
}

model Review {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  authorName String
  rating     Int // 1–5
  title      String?
  body       String
  // JSON array of uploaded photo paths, e.g. ["/uploads/x.jpg"].
  images     String   @default("[]")
  // True when the reviewer is a confirmed buyer (set once orders exist).
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId])
}

model Customer {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  // Public handle, e.g. @jordan. Unique across all customers when set.
  username     String?  @unique
  // Avatar image URL/path (uploaded via the profile page).
  image        String?
  // Contact phone number.
  phone        String?
  // Set when the customer registers an account (guests from checkout have none).
  passwordHash String?
  orders       Order[]
  addresses    Address[]
  createdAt    DateTime @default(now())
}

model Address {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  // Optional nickname, e.g. "Home" or "Work".
  label      String?
  fullName   String
  phone      String?
  line1      String
  line2      String?
  city       String
  state      String?
  zip        String
  country    String
  // The address used by default at checkout.
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}

model Order {
  id              String      @id @default(cuid())
  // Human-friendly order number, e.g. NUVO-7F3K9Q2A.
  orderNumber     String      @unique
  customer        Customer?   @relation(fields: [customerId], references: [id])
  customerId      String?
  email           String
  // One of: PENDING, PAID, ORDERED_WITH_SUPPLIER, SHIPPED, DELIVERED, CANCELLED, REFUNDED
  status          String      @default("PENDING")
  totalCents      Int
  // Shipping fee in USD minor units (part of totalCents). 0 = free.
  shippingCents   Int         @default(0)
  // One of: standard, express, pickup.
  deliveryMethod  String?
  currency        String      @default("usd")
  stripeSessionId String?     @unique
  shippingName    String?
  shippingLine1   String?
  shippingLine2   String?
  shippingCity    String?
  shippingState   String?
  shippingZip     String?
  shippingCountry String?
  supplierOrderId String?
  trackingNumber  String?
  carrier         String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  // Set once the "leave a review" email has been sent for this order.
  reviewRequestSent Boolean   @default(false)
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id         String   @id @default(cuid())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  product    Product? @relation(fields: [productId], references: [id])
  productId  String?
  // Snapshot of the product at purchase time (stays stable if the product changes).
  title      String
  slug       String?
  image      String?
  color      String?
  size       String?
  quantity   Int
  priceCents Int
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  // One of: ADMIN, STAFF
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
}
